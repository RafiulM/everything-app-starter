# Development Environment Variables
# Copy this file to .env and modify as needed
# Generate a secure secret: openssl rand -base64 32

# ============================================
# REQUIRED VARIABLES
# ============================================

# Database Configuration (Docker defaults - works with npm run db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Authentication (REQUIRED - Generate a secure secret)
BETTER_AUTH_SECRET=your_secret_key_here_generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ============================================
# OPTIONAL AI SERVICE KEYS
# ============================================

# OpenAI (for GPT models)
# Get keys from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic Claude (for Claude models)
# Get keys from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google AI (for Gemini models)
# Get keys from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-key-here

# Other AI Services
ANYSCALE_API_KEY=your-anyscale-key-here
TOGETHER_API_KEY=your-together-key-here

# ============================================
# OPTIONAL INTEGRATION KEYS
# ============================================

# Email Services
# Get Resend key from: https://resend.com/api-keys
RESEND_API_KEY=re-your-resend-key-here
# Get SendGrid key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-key-here

# Payment Processing (Stripe)
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# File Storage (AWS S3)
# Get credentials from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Application Settings
NODE_ENV=development
PORT=3000

# Database Connection Pooling (optional)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Next.js Configuration (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000